{
  "name": "malvisor-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "generate-validator": "node scripts/generate-validator.mjs",
    "predev": "npm run generate-validator",
    "pretypecheck": "npm run generate-validator",
    "pretest": "npm run generate-validator",
    "prebuild": "npm run generate-validator",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
